<Window x:Class="part.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     Title="LockWise AI"
     Width="1300"
Height="800"
     WindowStartupLocation="CenterScreen"
     Background="MidnightBlue">

    <Grid>

        <!-- HEADER -->
        <Grid Margin="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <StackPanel>

                <TextBlock Text="🔒 LockWise AI"
               FontSize="30"
               FontWeight="Bold"
               Foreground="White"/>

                <TextBlock Text="Cybersecurity Awareness Assistant"
               FontSize="16"
               Foreground="LightBlue"/>

            </StackPanel>

            <!-- RIGHT -->
            <StackPanel Grid.Column="1"
            HorizontalAlignment="Right">

                <TextBlock x:Name="lblUser"
               Text="👤 Welcome, Guest"
               FontSize="18"
               FontWeight="Bold"
               Foreground="White"/>

                <WrapPanel Margin="0,10,0,0">

                    <TextBlock x:Name="lblScore"
                   Text="🛡 Score: 100"
                   Margin="10,0"
                   Foreground="Lime"
                   FontWeight="Bold"/>

                    <TextBlock x:Name="lblTasks"
                   Text="📋 Tasks: 0"
                   Margin="10,0"
                   Foreground="White"/>

                    <TextBlock x:Name="lblCompleted"
                   Text="✅ Completed: 0"
                   Margin="10,0"
                   Foreground="White"/>

                    <TextBlock x:Name="lblQuiz"
                   Text="🎯 Quiz: 0/10"
                   Margin="10,0"
                   Foreground="Gold"/>

                </WrapPanel>

            </StackPanel>

        </Grid>

        <!-- LEFT PANEL -->
        <Border Background="DarkSlateBlue"
            Width="220"
            Margin="10,138,0,10"
            HorizontalAlignment="Left"
            CornerRadius="10">

            <StackPanel Margin="10">

                <TextBlock Text="Quick Actions"
                       Foreground="DeepSkyBlue"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="10"/>

                <Button x:Name="btnPassword"
                    Content="Password Safety"
                    Height="45"
                    Margin="5"
                    Background="DeepSkyBlue"
                    Foreground="White"/>

                <Button x:Name="btnPhishing"
                    Content="Phishing"
                    Height="45"
                    Margin="5"
                    Background="MediumPurple"
                    Foreground="White"/>

                <Button x:Name="btnBrowsing"
                    Content="Safe Browsing"
                    Height="45"
                    Margin="5"
                    Background="DeepSkyBlue"
                    Foreground="White"/>

                <Button x:Name="btnHelp"
                    Content="Help"
                    Height="45"
                    Margin="5"
                    Background="MediumPurple"
                    Foreground="White"/>

                <Button x:Name="btnClear"
                    Content="Clear Chat"
                    Height="45"
                    Margin="5"
                    Background="IndianRed"
                    Foreground="White"/>




            </StackPanel>

        </Border>


        <TabControl Margin="240,100,20,90"
        Background="#1E293B">

            <!-- CHAT TAB -->
            <TabItem Header="💬 Chat">

                <ScrollViewer x:Name="ChatScrollViewer"
                  VerticalScrollBarVisibility="Auto">

                    <StackPanel x:Name="ChatPanel"
                    Margin="15">

                        <Border Background="MediumPurple"
                    CornerRadius="12"
                    Padding="12"
                    Margin="5"
                    HorizontalAlignment="Left"
                    MaxWidth="400">

                            <TextBlock Text="LockWise AI: Hello! Welcome to LockWise AI. What is your name?"
                           Foreground="White"
                           FontSize="16"
                           TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </TabItem>

            <TabItem Header="📋 Tasks">

                <Grid Margin="20">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <TextBlock
        Text="Cybersecurity Task Manager"
        FontSize="24"
        FontWeight="Bold"
        Foreground="White"/>

                    <TextBox
        x:Name="txtTask"
        Grid.Row="1"
        Margin="0,10"
        FontSize="16"/>

                    <ListBox
        x:Name="lstTasks"
        Grid.Row="2"
        Margin="0,10"/>

                    <Button
        x:Name="btnAddTask"
        Grid.Row="3"
        Margin="0,5"
        Content="Add Task"/>

                    <StackPanel
        Grid.Row="4"
        Orientation="Horizontal">

                        <Button
            x:Name="btnCompleteTask"
            Width="180"
            Margin="0,5,10,0"
            Content="✔ Complete"/>

                        <Button
            x:Name="btnDeleteTask"
            Width="180"
            Margin="0,5"
            Content="🗑 Delete"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <TabItem Header="📜 Activity" HorizontalAlignment="Right" Width="71">

                <Grid Margin="20">

                    <StackPanel>

                        <TextBlock
            Text="Activity History"
            FontSize="24"
            FontWeight="Bold"
            Foreground="White"/>

                        <ListBox
            x:Name="lstActivity"
            Height="500"
            Margin="0,20,0,0"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <TabItem Header="🎮 Quiz">

                <Grid Margin="20">

                    <StackPanel>

                        <TextBlock Text="Cybersecurity Quiz"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="DeepSkyBlue"
                   Margin="0,0,0,20"/>

                        <TextBlock x:Name="txtQuestion"
                   Text="Question appears here..."
                   FontSize="20"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

                        <Button x:Name="btnOption1"
                Height="45"
                Margin="0,5"
                Background="DodgerBlue"
                Foreground="White"/>

                        <Button x:Name="btnOption2"
                Height="45"
                Margin="0,5"
                Background="DodgerBlue"
                Foreground="White"/>

                        <Button x:Name="btnOption3"
                Height="45"
                Margin="0,5"
                Background="DodgerBlue"
                Foreground="White"/>

                        <Button x:Name="btnOption4"
                Height="45"
                Margin="0,5"
                Background="DodgerBlue"
                Foreground="White"/>

                        <TextBlock x:Name="lblQuizScore"
                   Text="Score : 0"
                   FontSize="20"
                   Foreground="Lime"
                   Margin="0,25,0,0"/>

                    </StackPanel>

                </Grid>

            </TabItem>

        </TabControl>


        <!-- INPUT AREA -->
        <Border Background="DarkSlateBlue"
            Height="75"
            VerticalAlignment="Bottom"
            Margin="240,0,20,10"
            CornerRadius="15">

            <Grid>

                <TextBox x:Name="txtUserInput"
                     KeyDown="txtUserInput_KeyDown"
                     Margin="15,15,130,15"
                     FontSize="16"
                     Background="#1E293B"
                     Foreground="White"
                     BorderBrush="DeepSkyBlue"
                     BorderThickness="2"
                     CaretBrush="White"
                     Padding="10"/>

                <Button x:Name="btnSend"
                    Content="Send"
                    Width="90"
                    Height="40"
                    HorizontalAlignment="Right"
                    Margin="0,15,20,15"
                    Background="DeepSkyBlue"
                    Foreground="White"
                    FontWeight="Bold"/>

            </Grid>

        </Border>

    </Grid>

</Window>

